# --- Database ---------------------------------------------------------------
# SQLite (default, zero-ops) or Postgres: postgresql+psycopg://user:pass@host:5432/courtside
DATABASE_URL=sqlite:///./courtside.db

# --- Odds feed (optional; without it use manual odds entry) -----------------
# https://the-odds-api.com  — free tier = 500 credits/month.
# Cost per refresh = (#markets) x ceil(#bookmakers / 10) credits PER GAME.
ODDS_API_KEY=
ODDS_API_MARKETS=player_points
# Hard Rock Bet = hardrockbet (state variants: hardrockbet_fl, hardrockbet_az, hardrockbet_oh). Caesars = williamhill_us
ODDS_API_BOOKMAKERS=hardrockbet,draftkings,fanduel,betmgm,williamhill_us
PREFERRED_BOOK=hardrockbet
# Which scheduled runs pull odds: morning, afternoon, pregame (60 & 15 min before each game), pretip.
# Free tier (500/mo): morning,pretip ~= 2 credits per game per day. Paid: morning,afternoon,pregame,pretip
ODDS_FETCH_RUNS=morning,pretip
# Never let the monthly balance drop below this (spare credits for manual runs).
ODDS_API_MIN_CREDITS=20

# --- Eligibility filters (tune only via walk-forward evidence) --------------
MIN_EV=0.03
MAX_ODDS_AGE_MIN=45
MIN_GAMES_HISTORY=8
MAX_MODEL_MARKET_GAP=0.15
MAX_MINUTES_CV=0.35
MIN_PROB=0.30
MAX_PROB=0.85

# --- Staking analysis (informational; nothing is ever wagered) -------------
BANKROLL_UNITS=100
KELLY_FRACTION=0.25
MAX_STAKE_PCT=0.01

# --- Simulation --------------------------------------------------------------
N_SIMS=20000
RANDOM_SEED=7

# --- Notifications (optional) ------------------------------------------------
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Which notifications go to Telegram/Discord: digest (morning + pre-tip), withdrawal, ops (failures),
# recommendation (every individual pick as published), results. "all" = everything.
TELEGRAM_KINDS=digest,withdrawal,ops
DISCORD_KINDS=digest,withdrawal,ops
# The pre-tip digest is sent this many minutes before the first game of the slate.
PRETIP_DIGEST_MINUTES=30

CORS_ORIGINS=http://localhost:3000

# Weight on the model vs the no-vig market, in log-odds (1.0 = model only)
MARKET_BLEND_WEIGHT=1.0
